// This is your Prisma schema file for Wash2Go
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USUARIOS DEL SISTEMA
// ============================================================
model Usuario {
  id         String   @id @default(cuid())
  nombre     String
  email      String   @unique
  telefono   String?
  password   String
  rol        Rol      @default(TRABAJADOR)
  activo     Boolean  @default(true)
  avatar_url String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  ordenes_asignadas Orden[] @relation("TrabajadorOrdenes")
  gastos_registrados Gasto[]
  notificaciones Notificacion[]

  @@map("usuarios")
}

enum Rol {
  ADMIN
  SUPERVISOR
  TRABAJADOR
}

// ============================================================
// CLIENTES
// ============================================================
model Cliente {
  id                   String   @id @default(cuid())
  nombre               String
  telefono             String   @unique
  whatsapp_id          String?  @unique // ID de WhatsApp
  email                String?
  direccion_default    String?
  notas                String?
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relaciones
  vehiculos  Vehiculo[]
  ordenes    Orden[]
  sesion_wa  SesionWhatsApp?

  @@map("clientes")
}

// ============================================================
// VEHICULOS
// ============================================================
model Vehiculo {
  id         String       @id @default(cuid())
  cliente_id String
  marca      String
  modelo     String
  anio       Int
  color      String
  placa      String       @unique
  tipo       TipoVehiculo @default(SEDAN)
  foto_url   String?
  notas      String?
  activo     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relaciones
  cliente Cliente  @relation(fields: [cliente_id], references: [id])
  ordenes Orden[]

  @@map("vehiculos")
}

enum TipoVehiculo {
  SEDAN
  SUV
  PICKUP
  VAN
  MOTO
  CAMION
  OTRO
}

// ============================================================
// CATALOGO DE SERVICIOS
// ============================================================
model Servicio {
  id           String   @id @default(cuid())
  nombre       String
  descripcion  String?
  precio       Float
  duracion_min Int      @default(60) // duración estimada en minutos
  activo       Boolean  @default(true)
  color        String   @default("#0ea5e9") // color para UI
  icono        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  ordenes Orden[]

  @@map("servicios")
}

// ============================================================
// ORDENES DE LAVADO (núcleo del sistema)
// ============================================================
model Orden {
  id            String       @id @default(cuid())
  numero        String       @unique // ORD-2026-001
  cliente_id    String
  vehiculo_id   String
  servicio_id   String
  trabajador_id String?

  // Estado
  estado        EstadoOrden  @default(PENDIENTE)

  // Ubicación
  direccion     String
  lat           Float?
  lng           Float?
  referencia    String?      // Referencia de la ubicación

  // Económico
  precio        Float
  descuento     Float        @default(0)
  propina       Float        @default(0)
  total_cobrado Float        @default(0)
  forma_pago    FormaPago    @default(EFECTIVO)

  // Programación
  fecha_programada DateTime?
  hora_programada  String?   // "10:30"

  // Fotos
  foto_antes_url   String?
  foto_despues_url String?

  // Calificación del cliente
  calificacion      Int?     // 1-5
  nota_calificacion String?

  // Timestamps de estados
  iniciado_camino_at DateTime?
  iniciado_lavado_at DateTime?
  finalizado_at      DateTime?
  cancelado_at       DateTime?
  motivo_cancelacion String?

  // WhatsApp
  origen_whatsapp Boolean @default(false)

  // Notas
  notas String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  cliente    Cliente  @relation(fields: [cliente_id], references: [id])
  vehiculo   Vehiculo @relation(fields: [vehiculo_id], references: [id])
  servicio   Servicio @relation(fields: [servicio_id], references: [id])
  trabajador Usuario? @relation("TrabajadorOrdenes", fields: [trabajador_id], references: [id])
  movimientos_inventario MovimientoInventario[]

  @@map("ordenes")
}

enum EstadoOrden {
  PENDIENTE
  EN_CAMINO
  LAVANDO
  FINALIZADO
  CANCELADO
}

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

// ============================================================
// INVENTARIO DE PRODUCTOS
// ============================================================
model Inventario {
  id            String   @id @default(cuid())
  producto      String
  descripcion   String?
  cantidad      Float
  unidad        String   @default("unidad") // litros, unidades, etc
  costo_unitario Float   @default(0)
  stock_minimo  Float    @default(5)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  movimientos MovimientoInventario[]

  @@map("inventario")
}

model MovimientoInventario {
  id            String          @id @default(cuid())
  inventario_id String
  orden_id      String?
  tipo          TipoMovimiento
  cantidad      Float
  notas         String?
  createdAt     DateTime        @default(now())

  // Relaciones
  inventario Inventario @relation(fields: [inventario_id], references: [id])
  orden      Orden?     @relation(fields: [orden_id], references: [id])

  @@map("movimientos_inventario")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

// ============================================================
// GASTOS
// ============================================================
model Gasto {
  id           String      @id @default(cuid())
  tipo         TipoGasto
  descripcion  String
  monto        Float
  fecha        DateTime    @default(now())
  registrado_por_id String?
  comprobante_url   String?
  notas        String?
  createdAt    DateTime    @default(now())

  // Relaciones
  registrado_por Usuario? @relation(fields: [registrado_por_id], references: [id])

  @@map("gastos")
}

enum TipoGasto {
  PRODUCTO
  COMBUSTIBLE
  SALARIO
  MANTENIMIENTO
  OTRO
}

// ============================================================
// NOTIFICACIONES
// ============================================================
model Notificacion {
  id        String   @id @default(cuid())
  usuario_id String
  tipo      String   // "nueva_orden", "estado_cambiado", etc
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  data      Json?    // datos adicionales (orden_id, etc)
  createdAt DateTime @default(now())

  // Relaciones
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("notificaciones")
}

// ============================================================
// SESIONES WHATSAPP (para el bot conversacional)
// ============================================================
model SesionWhatsApp {
  id            String   @id @default(cuid())
  cliente_id    String?  @unique
  whatsapp_id   String   @unique // número de WhatsApp del cliente
  estado_flujo  String   @default("INICIO") // INICIO, ESPERANDO_SERVICIO, ESPERANDO_PLACA, etc
  datos_flujo   Json?    // datos recopilados del flujo
  ultimo_mensaje DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  cliente Cliente? @relation(fields: [cliente_id], references: [id])

  @@map("sesiones_whatsapp")
}
